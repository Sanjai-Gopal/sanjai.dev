# Groq API key for the "Ask Sanjai" AI chatbot.
# The key is used server-side only (src/app/api/chat/route.ts) and is never exposed to the client.
# Get a free API key from https://console.groq.com/keys
# Copy this file to .env.local and add your key there (never commit it).
GROQ_API_KEY=gsk_YOUR_TOKEN_HERE

# Optional Groq configuration (defaults shown):
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# Optional fallback provider (Hugging Face):
# HUGGINGFACE_API_KEY=hf_YOUR_TOKEN_HERE
# HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# HUGGINGFACE_API_BASE_URL=https://router.huggingface.co/v1
