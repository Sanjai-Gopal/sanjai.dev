# Hugging Face API key for the "Ask Sanjai" AI chatbot.
# The key is used server-side only (src/app/api/chat/route.ts) and is never exposed to the client.
# Get a token from https://huggingface.co/settings/tokens
# Copy this file to .env.local and add your key there (never commit it).
HUGGINGFACE_API_KEY=hf_YOUR_TOKEN_HERE

# Optional overrides (defaults shown):
# HUGGINGFACE_MODEL=zai-org/GLM-4.5-Air:fastest
# HUGGINGFACE_API_BASE_URL=https://router.huggingface.co/v1
